{
  "name": "school33-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check",
    "cms": "decap-server",
    "optimize-images": "node scripts/optimize-images.mjs",
    "build:cf": "DEPLOY_TARGET=cloudflare astro build",
    "deploy:cf": "SITE_URL=${SITE_URL:-https://school33-qibray.school33-web.workers.dev} npm run build:cf && wrangler deploy -c dist/server/wrangler.json",
    "preview:cf": "npm run build:cf && wrangler dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.4.11",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "decap-server": "^3.11.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
