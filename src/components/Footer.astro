---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SchoolDrawing from './SchoolDrawing.astro';
import { footerLinks, policyLinks, url } from '@/lib/routes';
import { useTranslations, type Locale } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
const socials = (['telegram', 'instagram', 'facebook', 'youtube'] as const).filter((k) => s.socials[k]);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo href={url(lang)} name={s.name[lang]} tagline={s.tagline[lang]} logo={s.logo} monogram={s.short_name} inverted />
      <ul class="footer__contacts">
        <li><Icon name="pin" size={18} /><span>{s.address[lang]}</span></li>
        {s.phone && <li><Icon name="phone" size={18} /><a href={`tel:${s.phone.replace(/[^+\d]/g, '')}`}>{s.phone}</a></li>}
        {s.email && <li><Icon name="mail" size={18} /><a href={`mailto:${s.email}`}>{s.email}</a></li>}
        {s.hours[lang] && <li><Icon name="clock" size={18} /><span>{s.hours[lang]}</span></li>}
      </ul>
    </div>

    <nav aria-label={t('footer.quickLinks')}>
      <h2 class="footer__title">{t('footer.quickLinks')}</h2>
      <ul class="footer__links">
        {footerLinks.map((l) => <li><a href={url(lang, l.path)}>{t(l.key)}</a></li>)}
      </ul>
    </nav>

    <nav aria-label={t('nav.contact')}>
      <h2 class="footer__title">{t('nav.contact')}</h2>
      <ul class="footer__links">
        <li><a href={url(lang, 'contact')}>{t('contact.form.title')}</a></li>
        <li><a href={url(lang, 'staff-leadership')}>{t('nav.about.staff')}</a></li>
        <li><a href={url(lang, 'about/directors-welcome')}>{t('nav.about.welcome')}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">{t('footer.follow')}</h2>
      {
        socials.length > 0 ? (
          <ul class="footer__social">
            {socials.map((k) => (
              <li>
                <a href={s.socials[k]} target="_blank" rel="noopener noreferrer" aria-label={k}>
                  <Icon name={k} size={20} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="footer__muted">{t('footer.socialSoon')}</p>
        )
      }
    </div>
  </div>

  <div class="footer__scene" aria-hidden="true">
    <div class="container">
      <SchoolDrawing label={s.short_name} class="footer__drawing" />
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <ul class="footer__legal">
        {policyLinks.map((l) => <li><a href={url(lang, l.path)}>{t(l.key)}</a></li>)}
      </ul>
      <p>© {year} {s.name[lang]}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: auto;
    background: var(--footer);
    color: rgb(255 255 255 / 0.85);
    padding-top: clamp(48px, 7vw, 80px);
  }
  .footer__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
  .footer__contacts {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 12px;
    font-size: 0.975rem;
  }
  .footer__contacts li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .footer__contacts :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--accent);
  }
  .footer__contacts a:hover,
  .footer__links a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__title {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: 0;
    color: #fff;
    margin-bottom: 16px;
  }
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-size: 0.975rem;
  }
  .footer__social {
    display: flex;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: #fff;
    transition: color 0.2s;
  }
  .footer__social a:hover {
    color: var(--accent);
  }
  .footer__muted {
    color: rgb(255 255 255 / 0.65);
    font-size: 0.95rem;
    max-width: 28ch;
  }

  /* Line drawing standing on a cyan ground line, full width */
  .footer__scene {
    margin-top: 40px;
    border-bottom: 2px solid var(--accent);
    color: var(--accent);
  }
  .footer__scene .container {
    display: flex;
    justify-content: flex-end;
  }
  .footer__scene :global(.footer__drawing) {
    width: min(100%, 320px);
    height: auto;
    margin-bottom: -2px; /* sit the drawing's ground on the full-width line */
  }

  .footer__bottom {
    padding-block: 18px;
    font-size: 0.9rem;
  }
  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__legal a {
    color: var(--accent);
  }
  .footer__legal a:hover {
    color: #fff;
  }
  .footer__bottom p {
    margin: 0;
    color: rgb(255 255 255 / 0.7);
  }
</style>
