---
import Icon from './Icon.astro';
import { parentOf, url } from '@/lib/routes';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  lead?: string;
  /** path after /<lang>/, used for breadcrumbs */
  path: string;
  eyebrow?: string;
}
const { lang, title, lead, path, eyebrow } = Astro.props;
const t = useTranslations(lang);
const parent = parentOf(path);
const crumbs = [
  { label: t('nav.home'), href: url(lang) },
  ...(parent && parent.path !== path ? [{ label: t(parent.key), href: url(lang, parent.path) }] : []),
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...crumbs, { label: title, href: url(lang, path) }].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, Astro.site ?? Astro.url.origin).href,
  })),
};
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <nav class="crumbs" aria-label={t('common.breadcrumbs')}>
      <ol>
        {
          crumbs.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
              <Icon name="chevron" size={14} />
            </li>
          ))
        }
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && lead !== title && <p class="lead page-hero__lead">{lead}</p>}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .page-hero {
    position: relative;
    padding: clamp(36px, 6vw, 72px) 0 clamp(36px, 5vw, 64px);
    background: linear-gradient(180deg, #e3f6fd 0%, #f4fbfe 60%, #fff 100%);
  }
  .page-hero::after {
    /* lime-to-cyan bar along the bottom edge */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--grad-green);
  }
  .page-hero h1 {
    max-width: 22ch;
    margin-bottom: 0.3em;
  }
  .page-hero__lead {
    max-width: 62ch;
    margin: 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .crumbs :global(svg) {
    transform: rotate(-90deg);
  }
  .crumbs a {
    text-decoration: underline;
    text-decoration-color: var(--brand-100);
    text-underline-offset: 3px;
  }
  .crumbs a:hover {
    color: var(--brand);
    text-decoration-color: currentColor;
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }
</style>
