---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { mainNav, url } from '@/lib/routes';
import { useTranslations, type Locale } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const settings = await getSettings();
const current = Astro.url.pathname;

const isActive = (path: string) => {
  const href = url(lang, path);
  return current === href || current.startsWith(href);
};
const groupActive = (paths: string[]) => paths.some(isActive);
---

<header class="site-header" data-header>
  <div class="utility">
    <div class="container utility__inner">
      <ul class="utility__contacts">
        {settings.phone && (
          <li><a href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`}><Icon name="phone" size={16} />{settings.phone}</a></li>
        )}
        {settings.email && (
          <li><a href={`mailto:${settings.email}`}><Icon name="mail" size={16} />{settings.email}</a></li>
        )}
      </ul>
      <LanguageSwitcher lang={lang} class="lang--utility" />
    </div>
  </div>
  <div class="container site-header__inner">
    <Logo
      href={url(lang)}
      name={settings.name[lang]}
      tagline={settings.tagline[lang]}
      logo={settings.logo}
      monogram={settings.short_name}
    />

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="nav__item nav__item--has-children">
                <a
                  href={url(lang, item.path)}
                  class:list={['nav__link', { 'is-active': groupActive(item.children.map((c) => c.path)) }]}
                  aria-haspopup="true"
                >
                  {t(item.key)}
                  <Icon name="chevron" size={16} class="nav__chevron" />
                </a>
                <ul class="nav__dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={url(lang, child.path)}
                        class:list={['nav__sublink', { 'is-active': current === url(lang, child.path) }]}
                        aria-current={current === url(lang, child.path) ? 'page' : undefined}
                      >
                        {t(child.key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={url(lang, item.path)}
                  class:list={['nav__link', { 'is-active': isActive(item.path) }]}
                  aria-current={current === url(lang, item.path) ? 'page' : undefined}
                >
                  {t(item.key)}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="nav__mobile-extra">
        <LanguageSwitcher lang={lang} />
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--dark btn--sm site-header__cta" href={url(lang, 'contact')}>{t('nav.contact')}</a>
      <button
        class="burger"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
      >
        <span class="sr-only">{t('menu.open')}</span>
        <span class="burger__lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header) {
    // Shrink + add background once the page is scrolled.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle) {
    const label = toggle.querySelector('.sr-only')!;
    const nav = header.querySelector<HTMLElement>('#site-nav')!;
    const desktop = window.matchMedia('(min-width: 1080px)');
    // On phones the closed menu is inert: nothing inside can be tapped or focused.
    const syncInert = () => {
      nav.inert = !desktop.matches && !header.classList.contains('is-open');
    };
    const setOpen = (open: boolean) => {
      if (!open && nav.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      // The header is pinned (position: fixed) while the menu is open; keep its space
      // so the page underneath doesn't jump.
      document.body.style.paddingTop = open && window.innerWidth < 1080 ? `${header.offsetHeight}px` : '';
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
      syncInert();
    };
    syncInert();
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    desktop.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    background: #fff;
    transition: box-shadow 0.3s;
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.25);
  }

  /* ----- Sky-blue utility bar ----- */
  .utility {
    background: var(--sky);
    color: var(--ink);
    font-size: 0.925rem;
  }
  .utility__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
  }
  .utility__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .utility__contacts a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .utility__contacts a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: var(--header-h);
    transition: height 0.3s var(--ease);
  }
  .site-header.is-scrolled .site-header__inner {
    height: 64px;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ----- Desktop nav ----- */
  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 12px;
    font-weight: 550;
    font-size: 0.975rem;
    color: var(--ink);
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 3px;
    border-radius: 3px;
    background: var(--grad-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav__link:hover,
  .nav__item:focus-within > .nav__link {
    color: var(--brand);
  }
  .nav__link.is-active::after {
    transform: scaleX(1);
  }
  :global(.nav__chevron) {
    transition: transform 0.3s var(--ease);
  }
  .nav__item:hover :global(.nav__chevron),
  .nav__item:focus-within :global(.nav__chevron) {
    transform: rotate(180deg);
  }
  .nav__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    min-width: 250px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: 0 14px 34px -12px rgb(0 0 0 / 0.3), 0 0 0 1px var(--line);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }
  .nav__dropdown::before {
    /* hover bridge so the menu doesn't close in the gap */
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  @media (min-width: 1080px) {
    .nav__item:hover .nav__dropdown,
    .nav__item:focus-within .nav__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }
  .nav__sublink {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: 0.975rem;
    color: var(--ink-2);
    transition: background-color 0.2s, color 0.2s;
  }
  .nav__sublink:hover {
    background: var(--brand-50);
    color: var(--brand);
  }
  .nav__sublink.is-active {
    color: var(--brand);
    font-weight: 600;
  }
  .nav__mobile-extra {
    display: none;
  }

  /* ----- Burger ----- */
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: var(--pill);
    border: 2px solid var(--ink);
    background: var(--surface);
    place-items: center;
  }
  .burger__lines {
    position: relative;
    display: block;
    width: 18px;
    height: 14px;
  }
  .burger__lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.35s var(--ease), opacity 0.2s, top 0.35s var(--ease);
  }
  .burger__lines span:nth-child(1) { top: 0; }
  .burger__lines span:nth-child(2) { top: 6px; }
  .burger__lines span:nth-child(3) { top: 12px; }
  .is-open .burger__lines span:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .is-open .burger__lines span:nth-child(2) { opacity: 0; }
  .is-open .burger__lines span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* ----- Mobile nav ----- */
  @media (max-width: 1079px) {
    .utility {
      display: none;
    }
    .burger {
      display: grid;
    }
    .site-header__cta {
      display: none;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      padding: 12px var(--gutter) 40px;
      background: var(--surface);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
      pointer-events: none; /* closed panel never receives taps */
    }
    .site-header.is-scrolled .nav {
      inset-block-start: 64px;
    }
    .is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
    }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav__item {
      border-bottom: 1px solid var(--line);
    }
    .nav__link {
      width: 100%;
      padding: 16px 4px;
      font-size: 1.25rem;
      font-weight: 650;
      background: none !important;
    }
    .nav__link::after {
      display: none;
    }
    :global(.nav__chevron) {
      display: none;
    }
    .nav__dropdown {
      position: static;
      min-width: 0;
      padding: 0 0 12px 8px;
      border: 0;
      box-shadow: none;
      background: none;
      opacity: 1;
      /* inherit, not visible: a visible child would stay tappable while the closed menu is hidden */
      visibility: inherit;
      transform: none;
    }
    .nav__dropdown::before {
      display: none;
    }
    .nav__sublink {
      padding: 10px 12px;
    }
    .nav__mobile-extra {
      display: block;
      padding-top: 24px;
    }
    .nav__item {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    }
    .is-open .nav__item {
      opacity: 1;
      transform: none;
    }
    .is-open .nav__item:nth-child(2) { transition-delay: 40ms; }
    .is-open .nav__item:nth-child(3) { transition-delay: 80ms; }
    .is-open .nav__item:nth-child(4) { transition-delay: 120ms; }
    .is-open .nav__item:nth-child(5) { transition-delay: 160ms; }
    .is-open .nav__item:nth-child(6) { transition-delay: 200ms; }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  @media (max-width: 1079px) {
    :global(html.menu-open) .site-header {
      position: fixed;
      inset: 0 0 auto;
      background: var(--surface);
    }
    .nav {
      overscroll-behavior: contain;
    }
  }
</style>
