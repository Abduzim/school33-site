---
// Shows the logo image from site settings, or the school number as a monogram until a logo is uploaded.
interface Props {
  name: string;
  tagline?: string;
  logo?: string;
  monogram: string;
  href: string;
  inverted?: boolean;
}
const { name, tagline, logo, monogram, href, inverted = false } = Astro.props;
---

<a href={href} class:list={['logo', { 'logo--inverted': inverted }]} aria-label={name}>
  {
    logo ? (
      <img src={logo} alt="" width="44" height="44" class="logo__img" />
    ) : (
      <span class="logo__mark" aria-hidden="true">
        {monogram}
      </span>
    )
  }
  <span class="logo__text">
    <span class="logo__name">{name}</span>
    {tagline && <span class="logo__tagline">{tagline}</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .logo__img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }
  .logo__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--grad-blue);
    color: #fff;
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .logo__name {
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo__tagline {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo--inverted .logo__name {
    color: #fff;
  }
  .logo--inverted .logo__tagline {
    color: rgb(255 255 255 / 0.7);
  }
</style>
