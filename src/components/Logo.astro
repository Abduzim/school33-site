---
// Shows the logo image from site settings, or the school number as a monogram until a logo is uploaded.
interface Props {
  name: string;
  tagline?: string;
  logo?: string;
  monogram: string;
  href: string;
  inverted?: boolean;
}
const { name, tagline, logo, monogram, href, inverted = false } = Astro.props;
---

<a href={href} class:list={['logo', { 'logo--inverted': inverted }]} aria-label={name}>
  {
    logo ? (
      <img src={logo} alt="" width="44" height="44" class="logo__img" />
    ) : (
      <span class="logo__mark" aria-hidden="true">
        {monogram}
      </span>
    )
  }
  <span class="logo__text">
    <span class="logo__name">{name}</span>
    {tagline && <span class="logo__tagline">{tagline}</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .logo__img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }
  /* The number plate: an ink square, like the number painted on the school building. */
  .logo__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.35rem;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.02em;
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-weight: 650;
    font-size: 1.1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo__tagline {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logo--inverted .logo__mark {
    background: #fff;
    color: var(--brand);
  }
  .logo--inverted .logo__tagline {
    color: rgb(255 255 255 / 0.7);
  }
</style>
