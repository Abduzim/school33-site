---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import NewsCard from '@/components/NewsCard.astro';
import EventItem from '@/components/EventItem.astro';
import SchoolDrawing from '@/components/SchoolDrawing.astro';
import { locales, useTranslations, type Locale } from '@/i18n/ui';
import { byDateAsc, byDateDesc, getLocalized, getLocalizedEntry, getSettings, isUpcoming } from '@/lib/content';
import { url } from '@/lib/routes';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const settings = await getSettings();
const home = await getLocalizedEntry('home', lang, 'index');
if (!home) throw new Error('Missing src/content/home/uz/index.md');
const h = home.data;
const { Content: Welcome } = await render(home);

const news = (await getLocalized('news', lang)).sort(byDateDesc).slice(0, 3);
// Take a few extra; the browser hides events that finished after the last build.
const events = (await getLocalized('events', lang)).filter((e) => isUpcoming(e)).sort(byDateAsc).slice(0, 6);
const albums = (await getLocalized('gallery', lang)).sort(byDateDesc);
const mosaic = albums.flatMap((a) => (a.data.images.length ? a.data.images : [])).slice(0, 5);

const link = (href: string) => (/^(https?:|mailto:|tel:|#)/.test(href) ? href : url(lang, href));
const isExternal = (href: string) => /^https?:/.test(href);
const showLife = events.length > 0 || mosaic.length > 0;
const linkLabel = (href: string) => (isExternal(href) ? new URL(href).hostname.replace(/^www\./, '') : t('common.readMore'));
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const tel = settings.phone.replace(/[^+\d]/g, '');
---

<BaseLayout lang={lang} title={h.title} description={h.description} image={h.hero_image}>
  <!-- Hero: sky gradient (or the school photo once uploaded) with a large white headline -->
  <section class:list={['hero', { 'hero--photo': h.hero_image }]}>
    {h.hero_image && <img class="hero__photo" src={h.hero_image} alt="" width="1600" height="900" fetchpriority="high" />}
    {
      !h.hero_image && (
        <>
          <span class="cloud cloud--a" aria-hidden="true" />
          <span class="cloud cloud--b" aria-hidden="true" />
        </>
      )
    }
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__place">{settings.address[lang]}</p>
        <h1>{h.hero_title}</h1>
        <p class="hero__lead">{h.hero_subtitle}</p>
        <div class="actions">
          <a class="btn btn--light" href={link(h.hero_primary.link)}>{h.hero_primary.label}</a>
          {h.hero_secondary && <a class="btn btn--outline-light" href={link(h.hero_secondary.link)}>{h.hero_secondary.label}</a>}
        </div>
      </div>
      {
        !h.hero_image && (
          <div class="hero__art">
            <SchoolDrawing label={settings.short_name} class="hero__drawing" />
          </div>
        )
      }
    </div>
  </section>

  <!-- Steps: a lime block with numbered columns -->
  {
    h.highlights.length > 0 && (
      <section class="steps-wrap">
        <div class="container">
          <div class="steps" data-reveal data-watch>
            <h2 class="steps__title">{h.highlights_title}</h2>
            <ol class="steps__list" data-stagger>
              {h.highlights.map((item, i) => (
                <li class="step">
                  <span class="step__num" aria-hidden="true">{i + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  {item.link && (
                    <a class="step__link" href={link(item.link)} {...ext(item.link)}>
                      {linkLabel(item.link)}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  <!-- School in numbers, inside a gradient frame -->
  {
    h.stats.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="guide frame" data-reveal="scale">
            <svg class="guide__icon draw" data-draw viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path pathLength="1" d="M29 18V7h6v11" />
              <path pathLength="1" d="M20 46c0-17 4-28 12-28s12 11 12 28" />
              <path pathLength="1" d="M14 46h36" />
              <circle pathLength="1" cx="32" cy="52" r="4" />
              <path pathLength="1" d="M10 22l-5-3M10 30H4M54 22l5-3M54 30h6" />
            </svg>
            <h2>{t('home.passport')}</h2>
            <span class="dash" aria-hidden="true" />
            <dl class="figures">
              {h.stats.map((s) => (
                <div class="figure">
                  <dt>{s.label}</dt>
                  <dd data-count>{s.value}</dd>
                </div>
              ))}
            </dl>
            <p class="guide__note">{t('home.passportNote')}</p>
            <div class="actions">
              <a class="btn btn--dark" href={url(lang, 'about')}>{t('nav.about.overview')}</a>
              <a class="btn btn--dark" href={url(lang, 'academics')}>{t('nav.academics')}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Leadership: text beside a photo -->
  <section class="section leader-wrap">
    <div class="container leader">
      <div class="leader__copy" data-reveal="left">
        <h2>{h.welcome_title}</h2>
        {
          h.welcome_author && (
            <p class="leader__name">
              <strong>{h.welcome_author}</strong>
              {h.welcome_role && <span>{h.welcome_role}</span>}
            </p>
          )
        }
        <div class="leader__text"><Welcome /></div>
        <a class="btn" href={url(lang, 'staff-leadership')}>{t('nav.about.staff')}</a>
      </div>
      <div class="leader__photo" data-reveal="right">
        <Media src={h.welcome_image} alt={h.welcome_author} ratio="5 / 4" icon="user" tone="accent" label={t('common.photoSoon')} width={800} height={640} />
      </div>
    </div>
  </section>

  <!-- News -->
  {
    news.length > 0 && (
      <section class="section section--tint">
        <div class="container">
          <div class="section-head">
            <h2>{t('home.news')}</h2>
          </div>
          <div class="grid grid-3">
            {news.map((n) => (
              <NewsCard
                lang={lang}
                slug={n.slug}
                title={n.data.title}
                description={n.data.description}
                date={n.data.date}
                cover={n.data.cover}
              />
            ))}
          </div>
          <div class="center">
            <a class="btn" href={url(lang, 'news')}>{t('common.viewAll')}</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Events + gallery (only once there is something to show) -->
  {
    showLife && (
      <section class="section section--tint">
        <div class="container split">
          <div data-upcoming-section>
            <div class="section-head">
              <h2>{t('home.events')}</h2>
              <a class="link-arrow" href={url(lang, 'events')}>{t('common.viewAll')}</a>
            </div>
            <ul class="event-list" data-upcoming-list data-limit="3">
              {events.map((e) => (
                <EventItem
                  lang={lang}
                  slug={e.slug}
                  title={e.data.title}
                  date={e.data.date}
                  endDate={e.data.end_date}
                  location={e.data.location}
                />
              ))}
            </ul>
            <p class="empty-note">{t('events.empty')}</p>
          </div>

          <div>
            <div class="section-head">
              <h2>{t('home.gallery')}</h2>
              <a class="link-arrow" href={url(lang, 'gallery')}>{t('common.viewAll')}</a>
            </div>
            <a class="mosaic" href={url(lang, 'gallery')} aria-label={t('nav.gallery')}>
              {Array.from({ length: 5 }).map((_, i) => (
                <div class={`mosaic__item mosaic__item--${i + 1}`}>
                  <Media src={mosaic[i]?.src} alt={mosaic[i]?.alt} ratio="auto" tone={i % 2 ? 'accent' : 'brand'} width={600} height={600} />
                </div>
              ))}
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Boxes for parents and teachers -->
  {
    h.cards.length > 0 && (
      <section class="section boxes-wrap">
        <div class="container boxes">
          {h.cards.map((c, i) => (
            <div class:list={['box', 'frame', { 'frame--blue': i % 2 === 1 }]} data-reveal style={`--d: ${i * 120}ms`}>
              {i % 2 === 0 ? (
                <svg class="box__icon draw" data-draw viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path pathLength="1" d="M32 16c-6-4-14-5-22-4v38c8-1 16 0 22 4 6-4 14-5 22-4V12c-8-1-16 0-22 4z" />
                  <path pathLength="1" d="M32 16v38" />
                  <path pathLength="1" d="M16 24h10M16 31h10M16 38h8M38 24h10M38 31h10M38 38h7" />
                </svg>
              ) : (
                <svg class="box__icon draw" data-draw viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect pathLength="1" x="8" y="12" width="48" height="32" rx="2" />
                  <path pathLength="1" d="M20 44l-6 12M44 44l6 12M32 44v6" />
                  <path pathLength="1" d="M16 22h14M16 29h20M16 36h10" />
                  <path pathLength="1" d="M42 26l4 4 6-8" />
                </svg>
              )}
              <h3>{c.title}</h3>
              <span class="dash" aria-hidden="true" />
              <p>{c.text}</p>
              {c.link && c.label && (
                <a class="btn btn--dark" href={link(c.link)} {...ext(c.link)}>{c.label}</a>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Contact block -->
  <section class="section section--tint support">
    <div class="container support__inner">
      <div class="support__copy" data-reveal>
        <h2>{h.cta_title}</h2>
        <p class="lead">{h.cta_text}</p>
        <div class="actions">
          {settings.phone && <a class="btn" href={`tel:${tel}`}><Icon name="phone" />{t('home.call')}</a>}
          <a class="btn btn--dark" href={link(h.cta_link)}>{h.cta_label}</a>
        </div>
      </div>
      <dl class="support__list" data-reveal style="--d: 120ms">
        <div>
          <dt>{t('contact.address')}</dt>
          <dd>
            {settings.address[lang]}
            {settings.map_link && (
              <a class="link-arrow" href={settings.map_link} target="_blank" rel="noopener noreferrer">{t('contact.map')}</a>
            )}
          </dd>
        </div>
        {settings.phone && (
          <div>
            <dt>{t('contact.phone')}</dt>
            <dd><a href={`tel:${tel}`}>{settings.phone}</a></dd>
          </div>
        )}
        {settings.email && (
          <div>
            <dt>{t('contact.email')}</dt>
            <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
          </div>
        )}
        {settings.hours[lang] && (
          <div>
            <dt>{t('contact.hours')}</dt>
            <dd>{settings.hours[lang]}</dd>
          </div>
        )}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .center {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  /* ----- Hero ----- */
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(60% 50% at 85% 15%, rgb(255 255 255 / 0.22), transparent 70%),
      radial-gradient(50% 40% at 10% 90%, rgb(255 255 255 / 0.18), transparent 70%),
      linear-gradient(175deg, #2a5797 0%, #4a80c4 45%, #86bbe8 100%);
  }
  .hero--photo {
    background: #2a5797;
  }
  .cloud {
    position: absolute;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    filter: blur(28px);
    pointer-events: none;
  }
  .cloud--a {
    width: 420px;
    height: 120px;
    top: 14%;
    right: -80px;
  }
  .cloud--b {
    width: 300px;
    height: 90px;
    top: 46%;
    left: 34%;
    background: rgb(255 255 255 / 0.1);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero--photo::before {
    /* darken the left side so the white text stays readable over any photo */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(20 50 90 / 0.75) 0%, rgb(20 50 90 / 0.35) 55%, transparent 80%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    min-height: clamp(460px, 62vh, 640px);
    padding-block: clamp(56px, 8vw, 104px) 0;
  }
  .hero--photo .hero__inner {
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .hero__copy {
    align-self: center;
    padding-bottom: clamp(40px, 6vw, 88px);
  }
  .hero--photo .hero__copy {
    max-width: 640px;
    padding-bottom: 0;
  }
  .hero__place {
    margin: 0 0 14px;
    font-weight: 500;
    color: rgb(255 255 255 / 0.9);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.6rem, 6vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 13ch;
    margin-bottom: 0.4em;
    text-shadow: 0 2px 16px rgb(10 30 60 / 0.25);
  }
  .hero__lead {
    max-width: 44ch;
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    line-height: 1.5;
    margin-bottom: 32px;
    text-shadow: 0 1px 10px rgb(10 30 60 / 0.25);
  }
  .hero__art {
    align-self: end;
    color: #fff;
  }
  .hero__art :global(.hero__drawing) {
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero__copy {
      padding-bottom: 8px;
    }
    .hero__art :global(.hero__drawing) {
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* ----- Motion: hero load sequence, clouds, steps ----- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__place,
    .hero h1,
    .hero__lead,
    .hero .actions {
      animation: rise 0.9s var(--ease) both;
    }
    .hero h1 {
      animation-delay: 0.08s;
    }
    .hero__lead {
      animation-delay: 0.18s;
    }
    .hero .actions {
      animation-delay: 0.28s;
    }
    .cloud--a {
      animation: drift 38s ease-in-out infinite alternate;
    }
    .cloud--b {
      animation: drift 46s ease-in-out -12s infinite alternate-reverse;
    }
    :global(.js) .step + .step::before {
      transform: scaleY(0);
      transition: transform 0.9s var(--ease) 0.35s;
    }
    :global(.js) .steps:global(.is-in) .step + .step::before {
      transform: scaleY(1);
    }
    :global(.js) .step__num {
      opacity: 0;
      transform: translateY(18px) scale(0.9);
      transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
      transition-delay: var(--d, 0ms);
    }
    :global(.js) .steps:global(.is-in) .step__num {
      opacity: 1;
      transform: none;
    }
    .box :global(.box__icon) {
      transition: transform 0.5s var(--ease);
    }
    .box:hover :global(.box__icon) {
      transform: translateY(-4px) rotate(-4deg);
    }
  }
  @media (max-width: 560px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .step + .step::before {
      transform: scaleX(0);
    }
    :global(.js) .steps:global(.is-in) .step + .step::before {
      transform: scaleX(1);
    }
  }

  /* ----- Steps (lime block) ----- */
  .steps-wrap {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .steps {
    background: var(--lime);
    color: var(--ink);
    padding: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 48px);
  }
  .steps__title {
    margin-bottom: clamp(24px, 4vw, 44px);
  }
  .steps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    padding: 0 clamp(16px, 2vw, 28px);
  }
  .step:first-child {
    padding-left: 0;
  }
  .step + .step::before {
    /* white divider; grows from the top when the block scrolls into view */
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgb(255 255 255 / 0.85);
    transform-origin: top;
  }
  .step__num {
    display: block;
    font-size: clamp(3rem, 5vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .step h3 {
    font-size: 1.45rem;
    font-weight: 550;
    margin-bottom: 14px;
  }
  .step p {
    font-size: 0.975rem;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .step__link {
    font-weight: 500;
    font-size: 0.975rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .step__link:hover {
    color: var(--brand-600);
  }
  @media (max-width: 960px) {
    .steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }
    .step + .step:nth-child(3) {
      padding-left: 0;
    }
    .step + .step:nth-child(3)::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .steps__list {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .step,
    .step + .step,
    .step + .step:nth-child(3) {
      padding: 24px 0;
    }
    .step:first-child {
      padding-top: 0;
    }
    .step + .step::before,
    .step + .step:nth-child(3)::before {
      display: block;
      right: 0;
      bottom: auto;
      width: auto;
      height: 1px;
      transform-origin: left;
    }
  }

  /* ----- Figures inside the gradient frame ----- */
  .guide {
    max-width: 900px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 56px);
  }
  .guide h2 {
    max-width: 16ch;
    margin: 0;
  }
  .guide__icon,
  .box__icon {
    position: absolute;
    top: clamp(24px, 4vw, 44px);
    right: clamp(24px, 4vw, 44px);
    width: clamp(56px, 8vw, 84px);
    height: auto;
    color: var(--accent);
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    margin: 8px 0 24px;
  }
  .figure {
    display: flex;
    flex-direction: column-reverse; /* number above its label */
    justify-content: flex-end;
    gap: 4px;
  }
  .figure dd {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }
  .figure dt {
    font-size: 0.975rem;
    color: var(--ink-2);
  }
  .guide__note {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 24px;
  }
  @media (max-width: 640px) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .guide h2 {
      padding-right: 64px;
    }
  }

  /* ----- Leadership ----- */
  .leader-wrap {
    padding-top: 0;
  }
  .leader {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .leader__name {
    display: flex;
    flex-direction: column;
    margin: 0 0 16px;
  }
  .leader__name strong {
    font-size: 1.3rem;
    font-weight: 650;
    color: var(--ink);
  }
  .leader__name span {
    color: var(--muted);
  }
  .leader__text {
    color: var(--ink-2);
    max-width: 52ch;
    margin-bottom: 28px;
  }
  .leader__photo {
    overflow: hidden;
  }
  @media (max-width: 800px) {
    .leader {
      grid-template-columns: 1fr;
    }
  }

  /* ----- Events + gallery ----- */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 72px);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .empty-note {
    display: none;
    color: var(--muted);
  }
  [data-upcoming-section].is-empty .empty-note {
    display: block;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 150px);
    gap: 8px;
  }
  .mosaic__item {
    overflow: hidden;
  }
  .mosaic__item :global(.media) {
    height: 100%;
  }
  .mosaic__item--1 {
    grid-row: span 2;
  }
  @media (max-width: 560px) {
    .mosaic {
      grid-template-rows: repeat(2, 110px);
    }
  }

  /* ----- Boxes ----- */
  .boxes-wrap {
    padding-top: 0;
  }
  .boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
