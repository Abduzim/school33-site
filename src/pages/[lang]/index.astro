---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import NewsCard from '@/components/NewsCard.astro';
import EventItem from '@/components/EventItem.astro';
import { locales, useTranslations, type Locale } from '@/i18n/ui';
import { byDateAsc, byDateDesc, getLocalized, getLocalizedEntry, getSettings, isUpcoming } from '@/lib/content';
import { url } from '@/lib/routes';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const settings = await getSettings();
const home = await getLocalizedEntry('home', lang, 'index');
if (!home) throw new Error('Missing src/content/home/uz/index.md');
const h = home.data;
const { Content: Welcome } = await render(home);

const news = (await getLocalized('news', lang)).sort(byDateDesc).slice(0, 3);
// Take a few extra; the browser hides events that finished after the last build.
const events = (await getLocalized('events', lang)).filter((e) => isUpcoming(e)).sort(byDateAsc).slice(0, 6);
const albums = (await getLocalized('gallery', lang)).sort(byDateDesc);
const mosaic = albums.flatMap((a) => (a.data.images.length ? a.data.images : [])).slice(0, 5);

const link = (href: string) => (/^(https?:|mailto:|tel:|#)/.test(href) ? href : url(lang, href));
const isExternal = (href: string) => /^https?:/.test(href);
const showLife = events.length > 0 || mosaic.length > 0;
const tel = settings.phone.replace(/[^+\d]/g, '');
---

<BaseLayout lang={lang} title={h.title} description={h.description} image={h.hero_image}>
  <!-- Hero: a page of the exercise book, with the school number written large -->
  <section class="hero paper">
    <div class="container hero__inner">
      <span class="margin-line hero__margin" aria-hidden="true"></span>
      <div class="hero__copy">
        <p class="eyebrow hero__place">{settings.address[lang]}</p>
        <h1>{h.hero_title}</h1>
        <p class="lead">{h.hero_subtitle}</p>
        <div class="hero__actions">
          <a class="btn" href={link(h.hero_primary.link)}>{h.hero_primary.label}</a>
          {h.hero_secondary && <a class="btn btn--ghost" href={link(h.hero_secondary.link)}>{h.hero_secondary.label}</a>}
        </div>
      </div>
      <p class="hero__numeral" aria-hidden="true">{settings.short_name}</p>

      {
        h.stats.length > 0 && (
          <div class="passport">
            <h2 class="passport__title">{t('home.passport')}</h2>
            <dl class="passport__list">
              {h.stats.map((s) => (
                <div class="passport__row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </section>

  <!-- About the school: ruled rows, one topic per line -->
  {
    h.highlights.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{h.highlights_title}</h2>
          </div>
          <ul class="topics">
            {h.highlights.map((item) => (
              <li class="topic">
                <h3 class="topic__title">
                  {item.link ? (
                    <a href={link(item.link)} {...(isExternal(item.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p class="topic__text">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Leadership -->
  <section class="section section--tint">
    <div class="container leader">
      <div class="leader__photo">
        <Media src={h.welcome_image} alt={h.welcome_author} ratio="4 / 5" icon="user" label={t('common.photoSoon')} width={480} height={600} />
      </div>
      <div class="leader__copy">
        <h2>{h.welcome_title}</h2>
        {
          h.welcome_author && (
            <p class="leader__name">
              <strong>{h.welcome_author}</strong>
              {h.welcome_role && <span>{h.welcome_role}</span>}
            </p>
          )
        }
        <div class="leader__text"><Welcome /></div>
        <a class="link-arrow" href={url(lang, 'staff-leadership')}>{t('nav.about.staff')}</a>
      </div>
    </div>
  </section>

  <!-- News -->
  {
    news.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>{t('home.news')}</h2>
            <a class="link-arrow" href={url(lang, 'news')}>{t('common.viewAll')}</a>
          </div>
          <div class="grid grid-3">
            {news.map((n) => (
              <NewsCard
                lang={lang}
                slug={n.slug}
                title={n.data.title}
                description={n.data.description}
                date={n.data.date}
                cover={n.data.cover}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Events + gallery (only once there is something to show) -->
  {
    showLife && (
      <section class="section">
        <div class="container split">
          <div data-upcoming-section>
            <div class="section-head">
              <h2>{t('home.events')}</h2>
              <a class="link-arrow" href={url(lang, 'events')}>{t('common.viewAll')}</a>
            </div>
            <ul class="event-list" data-upcoming-list data-limit="3">
              {events.map((e) => (
                <EventItem
                  lang={lang}
                  slug={e.slug}
                  title={e.data.title}
                  date={e.data.date}
                  endDate={e.data.end_date}
                  location={e.data.location}
                />
              ))}
            </ul>
            <p class="empty-note">{t('events.empty')}</p>
          </div>

          <div>
            <div class="section-head">
              <h2>{t('home.gallery')}</h2>
              <a class="link-arrow" href={url(lang, 'gallery')}>{t('common.viewAll')}</a>
            </div>
            <a class="mosaic" href={url(lang, 'gallery')} aria-label={t('nav.gallery')}>
              {Array.from({ length: 5 }).map((_, i) => (
                <div class={`mosaic__item mosaic__item--${i + 1}`}>
                  <Media src={mosaic[i]?.src} alt={mosaic[i]?.alt} ratio="auto" width={600} height={600} />
                </div>
              ))}
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Address and contacts -->
  <section class="section reach">
    <div class="container reach__inner">
      <div class="reach__copy">
        <h2>{h.cta_title}</h2>
        <p class="lead">{h.cta_text}</p>
        <div class="hero__actions">
          {settings.phone && <a class="btn" href={`tel:${tel}`}><Icon name="phone" />{t('home.call')}</a>}
          <a class="btn btn--ghost" href={link(h.cta_link)}>{h.cta_label}</a>
        </div>
      </div>
      <dl class="reach__list">
        <div>
          <dt>{t('contact.address')}</dt>
          <dd>
            {settings.address[lang]}
            {settings.map_link && (
              <a class="link-arrow" href={settings.map_link} target="_blank" rel="noopener noreferrer">{t('contact.map')}</a>
            )}
          </dd>
        </div>
        {settings.phone && (
          <div>
            <dt>{t('contact.phone')}</dt>
            <dd><a href={`tel:${tel}`}>{settings.phone}</a></dd>
          </div>
        )}
        {settings.email && (
          <div>
            <dt>{t('contact.email')}</dt>
            <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
          </div>
        )}
        {settings.hours[lang] && (
          <div>
            <dt>{t('contact.hours')}</dt>
            <dd>{settings.hours[lang]}</dd>
          </div>
        )}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* ----- Hero ----- */
  .hero {
    --pad-top: clamp(40px, 7vw, 88px);
    --pad-bottom: clamp(40px, 6vw, 72px);
    position: relative;
    overflow: hidden;
    padding: var(--pad-top) 0 var(--pad-bottom);
    border-bottom: 1px solid var(--rule);
  }
  .hero__inner {
    position: relative;
    --margin-x: var(--gutter);
    padding-left: calc(var(--gutter) + var(--cell) * 1.5);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    grid-template-areas:
      'copy numeral'
      'passport passport';
    column-gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .hero__margin {
    top: calc(var(--pad-top) * -1);
    bottom: calc(var(--pad-bottom) * -1);
    transform-origin: top;
    animation: rule-down 900ms var(--ease) both;
  }
  .hero__copy {
    grid-area: copy;
    padding-bottom: clamp(8px, 2vw, 24px);
  }
  .hero__place {
    color: var(--ink-2);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 5.2vw, 4.1rem);
    font-weight: 600;
    max-width: 15ch;
    margin-bottom: 0.35em;
  }
  .hero .lead {
    max-width: 50ch;
    margin-bottom: 28px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* The school number, written large in ink — the one loud thing on the page. */
  .hero__numeral {
    grid-area: numeral;
    justify-self: end;
    margin: 0;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 800;
    font-size: clamp(9rem, 24vw, 21rem);
    line-height: 0.78;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums;
    color: var(--brand);
    user-select: none;
    animation: ink-in 1100ms 200ms var(--ease) both;
  }
  @keyframes rule-down {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes ink-in {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }

  /* ----- School passport: a form with dotted leaders ----- */
  .passport {
    grid-area: passport;
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: 18px;
    border-top: 2px solid var(--brand);
    background: rgb(255 255 255 / 0.85);
  }
  .passport__title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 6px;
  }
  .passport__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 5vw, 72px);
    margin: 0;
  }
  .passport__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-height: calc(var(--cell) * 2);
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .passport__row dt {
    flex: none;
    max-width: 60%;
    color: var(--ink-2);
  }
  .passport__row::after {
    /* dotted leader between the label and the figure */
    content: '';
    order: 1;
    flex: 1;
    min-width: 16px;
    border-bottom: 1.5px dotted var(--rule);
    transform: translateY(-4px);
  }
  .passport__row dd {
    order: 2;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 650;
    font-size: 1.3rem;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--brand);
    text-align: right;
  }
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'numeral'
        'copy'
        'passport';
    }
    .hero__numeral {
      justify-self: start;
      font-size: clamp(7rem, 34vw, 11rem);
      margin-bottom: 20px;
    }
  }
  @media (max-width: 640px) {
    .passport__list {
      grid-template-columns: 1fr;
    }
  }

  /* ----- Topics ----- */
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--brand);
  }
  .topic {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 8px clamp(24px, 4vw, 56px);
    align-items: baseline;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .topic__title {
    margin: 0;
    font-size: 1.3rem;
  }
  .topic__title a {
    color: var(--brand);
    text-decoration: underline;
    text-decoration-color: var(--brand-100);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s;
  }
  .topic__title a:hover {
    text-decoration-color: currentColor;
  }
  .topic__text {
    margin: 0;
    color: var(--ink-2);
    max-width: 60ch;
  }
  @media (max-width: 720px) {
    .topic {
      grid-template-columns: 1fr;
    }
  }

  /* ----- Leadership ----- */
  .leader {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .leader__photo {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .leader__name {
    display: flex;
    flex-direction: column;
    margin: 0 0 18px;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
  }
  .leader__name strong {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .leader__name span {
    color: var(--muted);
  }
  .leader__text {
    color: var(--ink-2);
    max-width: 62ch;
  }
  @media (max-width: 760px) {
    .leader {
      grid-template-columns: 1fr;
    }
    .leader__photo {
      max-width: 240px;
    }
  }

  /* ----- Events + gallery ----- */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 72px);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .empty-note {
    display: none;
    color: var(--muted);
  }
  [data-upcoming-section].is-empty .empty-note {
    display: block;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 150px);
    gap: 8px;
  }
  .mosaic__item {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .mosaic__item :global(.media) {
    height: 100%;
  }
  .mosaic__item--1 {
    grid-row: span 2;
  }
  @media (max-width: 560px) {
    .mosaic {
      grid-template-rows: repeat(2, 110px);
    }
  }

  /* ----- Address and contacts ----- */
  .reach {
    border-top: 1px solid var(--rule);
  }
  .reach__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .reach__copy .lead {
    max-width: 44ch;
  }
  .reach__list {
    margin: 0;
    border-top: 2px solid var(--brand);
  }
  .reach__list > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .reach__list dt {
    color: var(--muted);
  }
  .reach__list dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-weight: 550;
  }
  .reach__list dd > a:not(.link-arrow) {
    color: var(--brand);
  }
  .reach__list dd > a:not(.link-arrow):hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 860px) {
    .reach__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .reach__list > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
