---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { locales, localeNames, defaultLocale, useTranslations, type Locale } from '@/i18n/ui';
import { switchLang } from '@/lib/routes';
import { getSettings } from '@/lib/content';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
}

const { lang, title, description, image, type = 'website', noindex = false, schema = [] } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
const siteName = s.name[lang];
// Titles that already start with the school name (e.g. the home page) are used as they are.
const fullTitle = title.startsWith(siteName) ? title : `${title} — ${siteName}`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ?? s.og_image;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: siteName,
  url: new URL(`/${lang}/`, site).href,
  telephone: s.phone,
  email: s.email,
  alternateName: [...new Set([s.name.uz, s.name.ru, s.name.en, ...(s.locality ? [`${s.name[lang]}, ${s.locality[lang]}`] : [])])].filter(
    (n) => n !== siteName,
  ),
  ...(description ? { description } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: s.address[lang],
    ...(s.locality ? { addressLocality: s.locality[lang] } : {}),
    ...(s.region ? { addressRegion: s.region[lang] } : {}),
    addressCountry: 'UZ',
  },
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
  ...(s.logo ? { logo: new URL(s.logo, site).href } : {}),
  ...(s.founded ? { foundingDate: s.founded } : {}),
  sameAs: Object.values(s.socials).filter(Boolean),
};
const isHome = Astro.url.pathname.replace(/\/$/, '') === `/${lang}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: [s.name.uz, s.name.ru, s.name.en].filter((n) => n !== siteName),
  url: new URL(`/${lang}/`, site).href,
  inLanguage: localeNames[lang].hreflang,
};
const jsonLd = [orgSchema, ...(isHome ? [websiteSchema] : []), ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {s.google_verification && <meta name="google-site-verification" content={s.google_verification} />}
    {s.yandex_verification && <meta name="yandex-verification" content={s.yandex_verification} />}
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={localeNames[l].hreflang} href={new URL(switchLang(Astro.url.pathname, l), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url.pathname, defaultLocale), site).href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeNames[lang].og} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#233a8f" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // ---------- Motion (styles: global.css → Motion) ----------
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Stagger index for each stroke of a line drawing, and for the step numbers.
      document.querySelectorAll<SVGElement>('[data-draw]').forEach((svg) =>
        svg.querySelectorAll<SVGElement>('path, rect, circle, line').forEach((el, i) => el.style.setProperty('--i', String(i))),
      );
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((list) =>
        [...list.children].forEach((el, i) => (el as HTMLElement).style.setProperty('--d', `${150 + i * 120}ms`)),
      );

      // Count a number up from 0 when it scrolls into view.
      const countUp = (el: HTMLElement) => {
        const target = Number((el.textContent || '').replace(/\D/g, ''));
        if (reduceMotion || !target || target < 2) return;
        const start = performance.now();
        const duration = 1200 + Math.min(target, 900);
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      };

      const reveal = (el: Element) => {
        el.classList.add('is-in');
        el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
        el.querySelectorAll('[data-draw]').forEach((d) => d.classList.add('is-in'));
      };
      const watched = document.querySelectorAll('[data-reveal], [data-draw], [data-watch]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        watched.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        watched.forEach((el) => io.observe(el));
      }

      // Events are built ahead of time, so hide the ones that have already finished.
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      document.querySelectorAll<HTMLElement>('[data-upcoming-list]').forEach((list) => {
        const limit = Number(list.dataset.limit || Infinity);
        const past = list.dataset.pastTarget ? document.querySelector<HTMLElement>(list.dataset.pastTarget) : null;
        let shown = 0;
        list.querySelectorAll<HTMLElement>('[data-event-end]').forEach((item) => {
          const ended = new Date(item.dataset.eventEnd + 'T23:59:59') < today;
          if (ended) {
            if (past) past.prepend(item);
            else item.remove();
          } else if (++shown > limit) {
            item.remove();
          }
        });
        if (past) past.closest<HTMLElement>('[data-past-section]')?.toggleAttribute('hidden', past.children.length === 0);
        list.closest<HTMLElement>('[data-upcoming-section]')?.classList.toggle('is-empty', shown === 0);
      });
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
</style>
