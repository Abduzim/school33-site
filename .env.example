# Copy to .env and fill in. Never commit the real .env file.

# Public address of the site, without a trailing slash.
SITE_URL=https://school33-qibray.onrender.com

# Port on the host machine (the container always uses 4321 inside).
WEB_PORT=4321

# Set to true when running behind a reverse proxy (Nginx/Caddy), so the real
# visitor IP is used for the contact-form rate limit.
TRUST_PROXY=true

# ---- PostgreSQL (stores contact-form messages in the contact_messages table) ----
# Optional. The table is created automatically on first use.
# Local:  postgresql://<user>@localhost:5432/school33
# Neon:   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=
# TLS is used automatically for non-local hosts. Override with true/false if needed.
# DATABASE_SSL=

# ---- Contact form email (SMTP) ----
# Without SMTP_HOST, messages are only printed to the container log.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=website@example.com
SMTP_PASS=change-me
# Who receives the messages, and the sender address
CONTACT_TO=info@example.com
CONTACT_FROM="School website <website@example.com>"

# ---- Content editor (/admin) login via GitHub ----
# Create an OAuth App: GitHub → Settings → Developer settings → OAuth Apps
#   Homepage URL:               https://school33-qibray.onrender.com
#   Authorization callback URL: https://school33-qibray.onrender.com/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
